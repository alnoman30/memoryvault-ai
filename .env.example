# MemoryVault AI - environment variables template.
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any real secret to Git.

# --- Supabase (public: safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SECRET: server only, never expose to the browser) ---
SUPABASE_SECRET_KEY=

# --- AI provider (server only) ---
# Which provider to use: gemini | local
AI_PROVIDER=gemini
GEMINI_API_KEY=

# External AI is OFF for sensitive documents unless the user gives
# explicit, informed consent inside the app.
