# MemoryVault AI - environment variables template.
# Copy this file to `.env.local` (local) or add the same names in
# Vercel > Project > Settings > Environment Variables (live site).
# NEVER commit `.env.local` or any real key to Git.

# --- Supabase (public: safe for the browser) ---
# Supabase > Project Settings > API Keys (Data API URL + "publishable" key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Gemini (SECRET: server only, never add NEXT_PUBLIC_) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional: change models without touching code ---
# Leave empty to use the defaults (free-tier models, with automatic fallback).
GEMINI_CHAT_MODEL=
GEMINI_READER_MODEL=
GEMINI_EMBEDDING_MODEL=

# --- Optional: biggest file (in MB) the AI will read. Bigger files are stored only.
AI_MAX_READ_MB=50
